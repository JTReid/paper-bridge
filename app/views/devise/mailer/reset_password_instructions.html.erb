<% reset_url = edit_password_url(@resource, reset_password_token: @token) -%>
<% name = @resource.try(:name).presence -%>
<% expires_in = Devise.reset_password_within.inspect -%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>Reset your PaperBridge password</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f8fafc; -webkit-text-size-adjust: 100%;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: #f8fafc;">
      Use this link to choose a new PaperBridge password. It expires in <%= expires_in %>.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc;">
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 560px;">
            <tr>
              <td style="padding: 0 4px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 22px; font-weight: 700; letter-spacing: -0.3px; color: #1d3e8b;">
                PaperBridge
              </td>
            </tr>

            <tr>
              <td style="background-color: #ffffff; border: 1px solid #dee5ed; border-radius: 16px; padding: 36px 32px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                <p style="margin: 0 0 8px; font-size: 12px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: #1d3e8b;">Password Help</p>
                <h1 style="margin: 0 0 20px; font-size: 24px; line-height: 32px; font-weight: 700; color: #213045;">Reset your password</h1>

                <p style="margin: 0 0 16px; font-size: 15px; line-height: 24px; color: #213045;">Hi <%= name || "there" %>,</p>
                <p style="margin: 0 0 28px; font-size: 15px; line-height: 24px; color: #213045;">
                  We received a request to reset the password for the PaperBridge account that uses <strong><%= @resource.email %></strong>. Choose a new password with the button below.
                </p>

                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 28px;">
                  <tr>
                    <td align="center" bgcolor="#1d3e8b" style="border-radius: 999px;">
                      <a href="<%= reset_url %>" target="_blank" style="display: inline-block; padding: 13px 28px; font-size: 15px; font-weight: 600; line-height: 20px; color: #ffffff; text-decoration: none; border-radius: 999px;">Change my password</a>
                    </td>
                  </tr>
                </table>

                <p style="margin: 0 0 8px; font-size: 14px; line-height: 22px; color: #58687e;">
                  This link expires in <%= expires_in %>. If the button doesn’t work, copy and paste this link into your browser:
                </p>
                <p style="margin: 0 0 28px; font-size: 13px; line-height: 20px; word-break: break-all;">
                  <a href="<%= reset_url %>" target="_blank" style="color: #1d3e8b; text-decoration: underline;"><%= reset_url %></a>
                </p>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="border-top: 1px solid #dee5ed; padding-top: 20px; font-size: 14px; line-height: 22px; color: #58687e;">
                      Didn’t ask to reset your password? You can safely ignore this email. Your password won’t change unless you open the link above and choose a new one.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 20px 4px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #58687e;">
                You’re receiving this because a password reset was requested for your PaperBridge account.<br>
                <a href="<%= root_url %>" target="_blank" style="color: #58687e; text-decoration: underline;">PaperBridge</a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
