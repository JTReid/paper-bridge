<% content_for :title, "Billing | PaperBridge" %>

<%= app_shell(active: :billing) do %>
  <% active = current_account.subscription_active? %>
  <% status_label =
    if @billing_subscription.nil?
      "Not started"
    elsif @billing_subscription.trialing?
      @billing_subscription.trial_end&.past? ? "Trial ended — awaiting billing update" : "Trial active"
    elsif @billing_subscription.active?
      "Active"
    elsif @billing_subscription.past_due? || @billing_subscription.unpaid?
      "Payment needed"
    elsif @billing_subscription.canceled?
      "Canceled"
    else
      "Not active"
    end %>

  <div class="space-y-8 pb-10" data-testid="billing-page">
    <header class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-1 text-xs font-medium uppercase tracking-widest text-accent">Family Billing</p>
        <h1 class="text-3xl font-bold tracking-tight text-primary">Subscription</h1>
        <p class="mt-1.5 text-sm text-muted-foreground">Manage the PaperBridge subscription for <%= current_account.name %>.</p>
      </div>
      <% if @can_manage_billing && @portal_ready %>
        <%= button_to billing_portal_session_path,
            method: :post,
            form: { data: { turbo: false } },
            class: "inline-flex h-10 items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-white shadow-sm transition-all duration-200 hover:bg-primary/90",
            data: { testid: "manage-subscription-button" } do %>
          <%= pb_icon("shield", class_name: "mr-1.5 h-4 w-4") %>
          Manage Subscription
        <% end %>
      <% end %>
    </header>

    <%= render "shared/profile_allowance", show_billing_link: false %>

    <% if @billing_subscription.nil? || @billing_subscription.can_start_checkout? || @billing_subscription.can_resume_checkout? || Billing::StripeConfig.profile_plan?(@billing_subscription) %>
      <section class="rounded-2xl border border-border/50 bg-white p-6 shadow-sm" aria-label="Profile subscription pricing" data-testid="profile-plan-pricing">
        <h2 class="text-base font-semibold text-foreground">One subscription for your family's profiles</h2>
        <% if @launch_trial_available %>
          <div class="mt-3 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900" data-testid="launch-trial-offer">
            <p class="font-semibold"><%= Billing::StripeConfig::LAUNCH_TRIAL_DAYS %> days free. $0 due today. Card required.</p>
            <p class="mt-2">Choose your profile allowance on Stripe. Your monthly price and first payment date are shown before you confirm. Cancel before your trial ends to avoid being charged. One launch trial per family account.</p>
          </div>
        <% end %>
        <p class="mt-2 text-sm text-muted-foreground"><%= "After your trial, " if @launch_trial_available %>$25 USD/month covers up to five managed profiles. Each additional profile is $5 USD/month.</p>
        <% if @launch_trial_available || (@billing_subscription&.trialing? && @billing_subscription.trial_end&.future?) %>
          <p class="mt-2 text-sm text-muted-foreground">Increasing your profile allowance during the trial keeps it free and does not change its end date. After the trial, increases apply immediately with a charge for the rest of the month. Reductions apply at the next billing date.</p>
        <% else %>
          <p class="mt-2 text-sm text-muted-foreground">Choose your profile allowance on Stripe. Increases apply immediately with a charge for the rest of the month; reductions apply at your next renewal.</p>
        <% end %>
      </section>
    <% end %>

    <section class="rounded-2xl border border-border/50 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl <%= active ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700" %>">
              <%= pb_icon(active ? "check-circle" : "alert-circle", class_name: "h-4 w-4") %>
            </span>
            <div>
              <h2 class="text-base font-semibold text-foreground" data-testid="billing-status">
                <%= active ? "Subscription active" : "Subscription required" %>
              </h2>
              <p class="mt-0.5 text-sm text-muted-foreground">
                Current status:
                <span class="font-medium text-foreground"><%= status_label %></span>
              </p>
            </div>
          </div>

          <% if @billing_subscription&.trialing? %>
            <div class="mt-4 space-y-2 text-sm text-muted-foreground" data-testid="billing-trial-details">
              <% if @billing_subscription.trial_end&.future? %>
                <p class="font-medium text-foreground">$0 during your free trial.</p>
                <p>Trial ends <%= l(@billing_subscription.trial_end.to_date, format: :long) %>.</p>
                <% if @billing_subscription.cancel_at_period_end? %>
                  <p>Your subscription is set to cancel at the end of the trial and will not renew.</p>
                <% else %>
                  <% if (monthly_price = profile_subscription_monthly_price(@billing_subscription)) %>
                    <p>After the trial: <%= monthly_price %> for your current allowance of <%= @billing_subscription.profile_limit %> managed profiles.</p>
                  <% end %>
                  <p>First payment is scheduled for <%= l(@billing_subscription.trial_end.to_date, format: :long) %> unless you cancel before then. See Stripe for your upcoming payment, including any scheduled allowance changes.</p>
                <% end %>
              <% elsif @billing_subscription.trial_end.present? %>
                <p>Your trial ended <%= l(@billing_subscription.trial_end.to_date, format: :long) %>. Stripe is confirming your billing status.</p>
              <% else %>
                <p>See Stripe for your trial end date and upcoming billing details.</p>
              <% end %>
            </div>
          <% elsif @billing_subscription&.current_period_end.present? %>
            <p class="mt-4 text-sm text-muted-foreground">
              <%= @billing_subscription.cancel_at_period_end? ? "Access ends" : "Renews" %> <%= l(@billing_subscription.current_period_end, format: :long) %>.
            </p>
          <% end %>

          <% if @billing_subscription&.cancel_at_period_end? %>
            <p class="mt-3 inline-flex rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-800">
              Will not renew
            </p>
          <% end %>
        </div>

        <div class="w-full md:w-auto">
          <% if @can_manage_billing && (@billing_subscription.nil? || @billing_subscription.can_start_checkout? || @billing_subscription.can_resume_checkout?) %>
            <% if @checkout_ready %>
              <%= button_to billing_checkout_session_path,
                  method: :post,
                  form: { data: { turbo: false } },
                  class: "flex h-10 w-full items-center justify-center rounded-full bg-accent px-5 text-sm font-medium text-accent-foreground shadow-sm transition-all duration-200 hover:bg-accent/80 md:w-auto",
                  data: { testid: "subscribe-button" } do %>
                <%= pb_icon("arrow-right", class_name: "mr-1.5 h-4 w-4") %>
                <%= if @billing_subscription&.can_resume_checkout?
                  "Continue Checkout"
                elsif @launch_trial_available
                  "Start #{Billing::StripeConfig::LAUNCH_TRIAL_DAYS}-day free trial"
                else
                  "Subscribe"
                end %>
              <% end %>
            <% else %>
              <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" data-testid="billing-setup-required">
                Online subscription setup is not available yet.
              </div>
            <% end %>
          <% elsif !@can_manage_billing %>
            <div class="rounded-xl border border-border bg-muted/40 p-4 text-sm text-muted-foreground">
              Ask the person who manages billing for your family account.
            </div>
          <% end %>
        </div>
      </div>
    </section>
  </div>
<% end %>
