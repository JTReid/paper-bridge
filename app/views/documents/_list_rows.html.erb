<div id="<%= dom_id(@dependent, :documents_rows) %>" data-document-list-target="results">
  <% if @documents.any? %>
    <section class="overflow-hidden rounded-2xl border border-border/60 bg-white shadow-sm">
      <div class="divide-y divide-border/40">
        <% @documents.each do |document| %>
          <div class="group flex items-center gap-3 px-5 py-4 transition-colors hover:bg-muted/20" data-testid="document-row-<%= document.id %>">
            <%= check_box_tag "document_selection[]", document.id, false, id: dom_id(document, :share_checkbox), class: "h-4 w-4 rounded border-border text-primary focus:ring-primary", aria: { label: "Select #{document.title}" }, data: { document_share_target: "checkbox", document_selection_target: "checkbox", action: "change->document-selection#update", document_title: document.title, document_filename: document.original_filename, testid: "document-share-checkbox-#{document.id}" } %>
            <%= link_to document_path(document), id: dom_id(document, :link), class: "flex min-w-0 flex-1 items-center gap-4" do %>
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-muted transition-colors group-hover:bg-primary/5">
                <%= pb_icon("file-text", class_name: "h-4 w-4 text-muted-foreground") %>
              </div>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-foreground"><%= document.title %></p>
                <p class="mt-0.5 truncate text-xs text-muted-foreground">
                  <%= document.original_filename.presence || "Attached file" %>
                  <span class="ml-2 text-muted-foreground">&middot; <%= document.dependent.name %></span>
                  <span class="ml-2 text-muted-foreground">&middot; <%= l document.created_at, format: :short %></span>
                </p>
              </div>
            <% end %>
            <span class="hidden rounded-full border-0 px-2 py-0.5 text-[10px] font-medium sm:inline-flex <%= document_category_classes(document.category) %>">
              <%= document.category.humanize %>
            </span>
            <span class="rounded-full border px-2 py-0.5 text-[10px] font-medium <%= document_status_classes(document) %>">
              <%= document_status_label(document) %>
            </span>
            <%= button_tag type: "button", id: dom_id(document, :share_button), class: "flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-primary/5 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary/20", aria: { label: "Share #{document.title}" }, data: { action: "document-share#open", document_share_document_id_param: document.id, document_share_document_title_param: document.title, testid: "document-share-button-#{document.id}" } do %>
              <%= pb_icon("share-2", class_name: "h-4 w-4") %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% else %>
    <section class="rounded-2xl border border-border/60 bg-white p-8 shadow-sm">
      <div class="mx-auto max-w-xl text-center">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl border border-primary/10 bg-primary/5">
          <%= pb_icon("file-text", class_name: "h-5 w-5 text-primary/50") %>
        </div>
        <% if @query %>
          <h2 class="text-base font-semibold text-foreground">No documents found</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">No file names match “<%= @query %>”<%= " in #{@category.humanize.downcase.singularize}" if @category %>.</p>
          <%= link_to "Clear search", dependent_documents_path(@dependent, category: @category), class: "mt-5 inline-flex rounded-full border border-primary/20 bg-white px-5 py-2 text-xs font-medium text-primary transition-colors hover:bg-primary/5", data: { testid: "documents-search-clear" } %>
        <% else %>
          <h2 class="text-base font-semibold text-foreground"><%= @category ? "No #{@category.humanize.downcase.singularize} documents yet" : "Start by adding your first document" %></h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Upload school reports, medical notes, prescriptions, therapy summaries, or insurance documents in one secure place.</p>
          <%= link_to @category ? "Add Documents" : "Add First Document", new_dependent_document_path(@dependent), class: "mt-5 inline-flex rounded-full bg-primary px-5 py-2 text-xs font-medium text-white transition-colors hover:bg-primary/90", data: { testid: "documents-empty-add-link" } %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
