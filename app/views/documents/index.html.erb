<% content_for :title, "Documents | PaperBridge" %>

<%= app_shell(active: :documents, dependent: @dependent) do %>
  <div data-controller="document-list" data-action="turbo:before-stream-render@document->document-list#beforeRender" data-document-list-url-value="<%= dependent_documents_path(@dependent, q: @query, category: @category) %>">
    <%= turbo_stream_from current_account, @dependent, :documents, data: { document_list_target: "stream" } %>
    <span id="<%= dom_id(@dependent, :documents_update) %>" hidden></span>
    <div class="space-y-8" data-controller="document-share document-selection" data-action="turbo:before-cache@document->document-selection#closeDelete document-list:updated->document-selection#update">
      <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="mb-1 text-xs font-medium uppercase tracking-widest text-accent">Care Records</p>
          <h1 class="text-2xl font-bold tracking-tight text-primary md:text-3xl"><%= @dependent ? "#{@dependent.name}'s Documents" : "Documents" %></h1>
          <p class="mt-1.5 text-sm text-muted-foreground">All records for this profile in one place. Files marked Ready can be used by Ask PaperBridge.</p>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row">
          <%= link_to dependent_ai_assistant_path(@dependent),
              class: "inline-flex h-10 items-center justify-center rounded-full border border-accent text-primary px-4 text-xs font-medium transition-colors hover:bg-accent/10",
              data: {
                action: "product-tour#advance",
                product_tour_from_phase_param: "open_ask",
                product_tour_next_phase_param: "ask_question",
                testid: "documents-ask-ai-link",
                tour: "open-ask"
              } do %>
            <%= pb_icon("sparkles", class_name: "mr-1.5 h-3.5 w-3.5") %>
            Ask PaperBridge
          <% end %>
          <%= link_to new_dependent_document_path(@dependent),
              class: "inline-flex h-10 items-center justify-center rounded-full bg-accent px-5 text-sm font-medium text-accent-foreground shadow-sm transition-all duration-200 hover:bg-accent/80",
              data: {
                action: "product-tour#advance",
                product_tour_from_phase_param: "add_documents",
                product_tour_next_phase_param: "choose_files",
                testid: "documents-add-link",
                tour: "add-documents"
              } do %>
            <%= pb_icon("upload", class_name: "mr-1.5 h-4 w-4") %>
            Add Documents
          <% end %>
        </div>
      </header>

      <%= render "list_counts" %>

      <section class="space-y-3">
        <%= form_with url: dependent_documents_path(@dependent), method: :get, class: "relative flex-1", data: { controller: "document-search", testid: "documents-search-form" } do |form| %>
          <%= form.hidden_field :category, value: @category if @category %>
          <%= pb_icon("search", class_name: "pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground") %>
          <%= form.search_field :q, value: @query, placeholder: "Search by file name...", class: "h-10 w-full rounded-xl border border-border bg-white pl-9 pr-3 text-sm text-foreground outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/10", aria: { label: "Search documents by file name" }, data: { action: "search->document-search#clear", testid: "documents-search-field" } %>
        <% end %>
        <nav class="flex flex-wrap gap-2" aria-label="Filter documents by category" data-testid="documents-category-filters">
          <%= link_to "All Categories", dependent_documents_path(@dependent, q: @query), class: "inline-flex h-8 items-center rounded-full border px-3 text-xs font-medium transition-colors #{@category ? 'border-border bg-white text-muted-foreground hover:bg-muted' : 'border-primary bg-primary text-white'}", aria: { current: @category.nil? ? "page" : nil }, data: { testid: "documents-category-filter-all" } %>
          <% Document.categories.each_key do |category| %>
            <% selected = @category == category %>
            <%= link_to category.humanize, dependent_documents_path(@dependent, category: category, q: @query), class: "inline-flex h-8 items-center rounded-full border px-3 text-xs font-medium transition-all #{document_category_classes(category)} #{selected ? 'border-current ring-2 ring-current/20' : 'border-transparent hover:border-current/20'}", aria: { current: selected ? "page" : nil }, data: { testid: "documents-category-filter-#{category}" } %>
          <% end %>
        </nav>
      </section>

      <div class="<%= @documents.any? ? "flex" : "hidden" %> flex-col gap-3 rounded-2xl border border-border/60 bg-white px-5 py-3 shadow-sm sm:flex-row sm:items-center sm:justify-between" data-testid="documents-selection-bar" data-document-list-target="selectionBar">
        <label class="flex items-center gap-3 text-sm text-muted-foreground">
          <input type="checkbox" class="h-4 w-4 rounded border-border text-primary focus:ring-primary" aria-label="Select all documents shown" data-document-selection-target="selectAll" data-action="change->document-selection#toggleAll" data-testid="documents-select-all">
          <span data-document-selection-target="count" data-testid="documents-selection-count"></span>
        </label>
        <div class="hidden flex-wrap gap-2" data-document-selection-target="actions" data-testid="documents-selection-actions">
          <%= button_tag type: "button", class: "inline-flex h-9 items-center rounded-full border border-primary/20 bg-white px-4 text-xs font-medium text-primary transition-colors hover:bg-primary/5", data: { action: "document-share#open", testid: "documents-selection-share" } do %>
            <%= pb_icon("share-2", class_name: "mr-1.5 h-3.5 w-3.5") %>
            Share selected
          <% end %>
          <%= button_tag type: "button", class: "inline-flex h-9 items-center rounded-full border border-red-200 bg-white px-4 text-xs font-medium text-red-700 transition-colors hover:bg-red-50", data: { action: "document-selection#openDelete", testid: "documents-selection-delete" } do %>
            <%= pb_icon("trash-2", class_name: "mr-1.5 h-3.5 w-3.5") %>
            Delete selected
          <% end %>
          <%= button_tag "Clear", type: "button", class: "inline-flex h-9 items-center rounded-full px-3 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground", data: { action: "document-selection#clear", testid: "documents-selection-clear" } %>
        </div>
      </div>

      <%= render "list_rows" %>

      <div class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-950/35 px-4 py-6 backdrop-blur-sm sm:px-6" data-document-share-target="modal" data-action="click->document-share#closeOnBackdrop keydown@window->document-share#closeWithKeyboard" data-testid="document-share-dialog" role="dialog" aria-hidden="true" aria-modal="true" aria-labelledby="share-documents-title">
        <div class="mx-auto flex min-h-full w-full max-w-3xl items-center" data-document-share-backdrop="true">
          <%= form_with url: share_events_path(dependent_id: @dependent&.id), scope: :share_event, class: "w-full rounded-2xl border border-border/60 bg-white p-6 shadow-2xl shadow-slate-950/20 sm:p-7", data: { action: "click->document-share#keepOpen" } do |form| %>
            <div data-document-share-target="selectedFields"></div>
            <div class="mb-3 flex justify-end">
              <button type="button" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border/70 bg-white text-slate-600 shadow-sm transition-colors hover:bg-muted hover:text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20" data-action="document-share#close" data-testid="document-share-close" aria-label="Close share dialog">
                <%= pb_icon("x", class_name: "h-4 w-4") %>
              </button>
            </div>
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
              <div>
                <h2 id="share-documents-title" class="text-sm font-semibold text-foreground">Share Documents</h2>
                <p class="mt-1 text-sm text-muted-foreground">Select one or more records below and send the original files by email.</p>
                <p class="mt-2 text-xs font-medium text-primary" data-document-share-target="selectedSummary"></p>
              </div>
              <div class="space-y-3">
                <% if @share_recipient_options.any? %>
                  <%= select_tag "care_team_recipient", options_for_select(@share_recipient_options), include_blank: "Choose care team email", class: "h-11 w-full rounded-xl border border-border bg-white px-3 text-sm text-foreground outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/10", aria: { label: "Choose care team email" }, data: { action: "change->document-share#selectRecipient", testid: "document-share-recipient-select" } %>
                <% end %>
                <%= form.email_field :recipient_email, placeholder: "Recipient email", required: true, class: "h-11 w-full rounded-xl border border-border bg-white px-3 text-sm text-foreground outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/10", data: { document_share_target: "recipientEmail", testid: "document-share-recipient-email" } %>
                <%= form.text_field :subject, placeholder: "Subject (optional)", class: "h-11 w-full rounded-xl border border-border bg-white px-3 text-sm text-foreground outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/10", data: { testid: "document-share-subject" } %>
                <%= form.text_area :message, rows: 4, placeholder: "Message (optional)", class: "w-full resize-none rounded-xl border border-border bg-white px-3 py-2 text-sm text-foreground outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/10", data: { testid: "document-share-message" } %>
                <%= form.submit "Share Selected", class: "inline-flex h-11 w-full items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-primary/90", data: { testid: "document-share-submit" } %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <dialog class="fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none overflow-y-auto border-0 bg-transparent px-4 py-6 backdrop:bg-slate-950/35 backdrop:backdrop-blur-sm sm:px-6" data-document-selection-target="deleteModal" data-action="click->document-selection#closeOnBackdrop cancel->document-selection#closeDelete" data-testid="documents-delete-dialog" aria-hidden="true" aria-labelledby="delete-documents-title">
        <div class="mx-auto flex min-h-full w-full max-w-lg items-center" data-document-selection-backdrop="true">
          <%= form_with url: dependent_documents_path(@dependent), method: :delete, class: "w-full rounded-2xl border border-border/60 bg-white p-6 shadow-2xl shadow-slate-950/20 sm:p-7", data: { action: "click->document-selection#keepOpen", testid: "documents-delete-form" } do |form| %>
            <div data-document-selection-target="deleteFields"></div>
            <%= form.hidden_field :category, value: @category if @category %>
            <%= form.hidden_field :q, value: @query if @query %>
            <h2 id="delete-documents-title" class="text-base font-semibold text-foreground" data-document-selection-target="deleteSummary"></h2>
            <p class="mt-1 text-sm text-muted-foreground">These records and their original files will be permanently removed from <%= @dependent.name %>'s documents. This cannot be undone.</p>
            <ul class="mt-4 max-h-56 space-y-1 overflow-y-auto rounded-xl border border-border/60 bg-muted/30 px-4 py-3 text-sm text-foreground" data-document-selection-target="deleteList" data-testid="documents-delete-list"></ul>
            <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
              <%= button_tag "Cancel", type: "button", autofocus: true, class: "inline-flex h-11 items-center justify-center rounded-full border border-border bg-white px-5 text-sm font-medium text-foreground transition-colors hover:bg-muted", data: { action: "document-selection#closeDelete", testid: "documents-delete-cancel" } %>
              <%= form.submit "Delete", class: "inline-flex h-11 items-center justify-center rounded-full bg-red-600 px-5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300", data: { document_selection_target: "deleteSubmit", testid: "documents-delete-submit" } %>
            </div>
          <% end %>
        </div>
      </dialog>
    </div>
  </div>
<% end %>
