<%= app_shell(active: :documents, dependent: @dependent) do %>
<%= turbo_stream_from @document %>

<div class="flex flex-col gap-8">
  <nav aria-label="Document navigation">
    <%= link_to dependent_documents_path(@dependent),
        class: "inline-flex items-center text-sm font-medium text-slate-600 hover:text-slate-950",
        data: {
          action: "product-tour#advance",
          product_tour_from_phase_param: "open_ask",
          product_tour_next_phase_param: "open_ask",
          testid: "document-back-to-documents",
          tour: "back-to-documents"
        } do %>
      <span aria-hidden="true" class="mr-2">&larr;</span>
      Back to documents
    <% end %>
  </nav>

  <section class="border-b border-slate-200 pb-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <%= render "documents/processing_status", document: @document %>

        <h1 class="text-3xl font-semibold text-slate-950"><%= @document.title %></h1>

        <%= render "documents/description", document: @document %>
      </div>

      <div class="flex flex-wrap gap-3">
        <% if @document.file.attached? %>
          <% if @document.content_type == "application/pdf" %>
            <%= link_to "Open original", original_document_path(@document), target: "_blank", rel: "noopener", class: "inline-flex justify-center rounded-md bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800", data: { testid: "document-open-original" } %>
          <% else %>
            <%= link_to "Download original", original_document_path(@document), download: @document.original_filename, class: "inline-flex justify-center rounded-md bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800", data: { testid: "document-download-original" } %>
          <% end %>
        <% end %>
        <%= link_to "Edit document", edit_document_path(@document), class: "inline-flex justify-center rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50", data: { testid: "document-edit-link" } %>
        <%= button_to "Delete document", @document, method: :delete, form: { data: { turbo_confirm: "Delete this document?" } }, class: "inline-flex justify-center rounded-md border border-red-200 bg-white px-3 py-2 text-sm font-semibold text-red-700 shadow-sm hover:bg-red-50" %>
      </div>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <div class="space-y-6">
      <%= render "documents/processing_stats", document: @document %>
      <%= render "documents/summary", document: @document %>
    </div>

    <%= render "documents/file_details", document: @document %>
  </section>
</div>
<% end %>
