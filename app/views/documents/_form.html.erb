<%
  editing = document.persisted?
  form_url = editing ? document_path(document) : dependent_documents_path(@dependent)
  cancel_path = editing ? document_path(document) : dependent_documents_path(@dependent)
  submit_label = editing ? "Save changes" : "Upload"
  error_action = editing ? "saving" : "uploading"
  category_options = Document.categories.keys.map { |category| [category.humanize, category] }
  category_options_json = json_escape(category_options.map { |label, value| { label: label, value: value } }.to_json)
%>

<% form_data = { testid: editing ? "document-edit-form" : "document-upload-form" } %>
<% unless editing %>
  <% form_data.merge!(
    action: "input->product-tour#pause turbo:submit-end->product-tour#advanceAfterSubmit",
    controller: "file-dropzone",
    file_dropzone_category_options_value: category_options_json,
    product_tour_from_phase_param: "upload_submit",
    product_tour_next_phase_param: "open_ask",
    tour: "upload-form"
  ) %>
<% end %>

<%= form_with model: document, url: form_url, class: "space-y-6 rounded-2xl border border-border/50 bg-white p-6 shadow-sm", data: form_data do |form| %>
  <% if document.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-900" role="alert" data-testid="document-form-errors">
      <h2 class="text-sm font-semibold"><%= pluralize(document.errors.count, "error") %> prevented this document from <%= error_action %></h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% document.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if editing %>
    <div>
      <%= form.label :title, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :title, class: "mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100", data: { testid: "document-title-field" } %>
    </div>
  <% end %>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_area :description, rows: 4, class: "mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100", data: { testid: "document-description-field" } %>
  </div>

  <div>
    <%= form.label :category, class: "block text-sm font-medium text-slate-700" %>
    <%= form.select :category, category_options, {}, class: "mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100", data: { testid: "document-category-field", file_dropzone_target: editing ? nil : "category", action: editing ? nil : "change->file-dropzone#categoryChanged" }.compact %>
  </div>

  <% unless editing %>
    <div>
      <%= form.label :files, "Files", class: "block text-sm font-medium text-slate-700" %>
      <div class="relative mt-2 rounded-lg border border-dashed border-slate-300 bg-slate-50/70 p-6 text-center transition-colors hover:border-emerald-500 hover:bg-emerald-50/70" data-file-dropzone-target="dropzone" data-action="dragover->file-dropzone#dragOver dragleave->file-dropzone#dragLeave drop->file-dropzone#drop" data-tour="choose-files">
        <%= form.file_field :files, multiple: true, required: true, accept: Documents::UploadNormalizer::ACCEPT_ATTRIBUTE, class: "absolute inset-0 h-full w-full cursor-pointer opacity-0", data: { testid: "document-file-field", file_dropzone_target: "input", action: "change->file-dropzone#changed change->product-tour#filesSelected" }, aria: { describedby: "document-files-summary" } %>
        <div class="pointer-events-none flex flex-col items-center gap-3">
          <span class="flex h-12 w-12 items-center justify-center rounded-full border border-emerald-100 bg-white text-emerald-700 shadow-sm">
            <%= pb_icon("upload", class_name: "h-5 w-5") %>
          </span>
          <div>
            <p class="text-sm font-semibold text-slate-900">Drop files here or choose files</p>
            <p id="document-files-summary" class="mt-1 text-sm text-slate-600" data-file-dropzone-target="summary" data-testid="document-file-summary">No files selected</p>
          </div>
        </div>
      </div>
      <ul class="mt-3 hidden space-y-2" data-file-dropzone-target="list" data-testid="document-file-list"></ul>
    </div>
  <% end %>

  <div class="flex items-center justify-end gap-3 border-t border-slate-200 pt-6">
    <%= link_to "Cancel", cancel_path, class: "rounded-md px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
    <%= form.button submit_label, type: :submit, class: "rounded-md bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800", data: { testid: editing ? "document-save-submit" : "document-upload-submit", tour: editing ? nil : "upload-submit" }.compact %>
  </div>
<% end %>
