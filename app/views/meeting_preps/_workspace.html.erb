<span hidden data-meeting-prep-target="message" data-error="<%= @alert.present? %>"><%= @alert.presence || @notice %></span>

<section class="space-y-3 rounded-2xl border border-border/50 bg-white p-4 sm:p-6">
  <h2 class="text-base font-semibold text-foreground">Add saved answers</h2>
  <div>
    <%= label_tag "meeting-prep-picker-search", "Find saved answers to add", class: "block text-sm font-medium text-foreground" %>
    <div class="mt-2 flex items-center gap-3">
      <%= search_field_tag nil, nil, id: "meeting-prep-picker-search", placeholder: "Search answers, notes, or sources", autocomplete: "off", class: "block h-11 min-w-0 flex-1 rounded-xl border border-border bg-white px-3 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/10", data: { meeting_prep_target: "pickerQuery", action: "input->meeting-prep#filterPicker", testid: "meeting-prep-picker-search" } %>
      <button id="meeting-prep-picker-clear" type="button" hidden class="h-11 rounded-full border border-border px-4 text-sm font-medium text-primary hover:bg-muted" data-meeting-prep-target="pickerClear" data-action="meeting-prep#clearPicker" data-testid="meeting-prep-picker-clear">Clear</button>
    </div>
  </div>

  <%= form_with url: dependent_meeting_prep_meeting_prep_answers_path(@dependent, @meeting_prep), method: :post, data: { meeting_prep_target: "pickerForm" }, class: "space-y-3" do |form| %>
    <fieldset class="min-w-0">
      <legend class="sr-only">Saved answers to add</legend>
      <div id="meeting-prep-choices" class="max-h-[min(40dvh,30rem)] space-y-2 overflow-y-auto overscroll-contain md:max-h-[min(60dvh,30rem)]" data-meeting-prep-target="choices" role="group" tabindex="0" aria-label="Available saved answers">
        <% @available_saved_answers.each do |saved_answer| %>
          <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-border/50 p-3 hover:bg-muted/30" data-meeting-prep-target="choice" data-search-text="<%= saved_answer.search_text %>">
            <%= check_box_tag "saved_answer_ids[]", saved_answer.id, false, id: dom_id(saved_answer, :choice), class: "mt-1 h-4 w-4 shrink-0 accent-primary", data: { action: "change->meeting-prep#selectionChanged", testid: "meeting-prep-answer-choice-#{saved_answer.id}" } %>
            <span class="min-w-0 flex-1">
              <span class="block break-words text-sm font-medium text-foreground"><%= saved_answer.display_title %></span>
              <span class="mt-1 block truncate text-xs leading-relaxed text-muted-foreground" data-testid="meeting-prep-answer-preview"><%= truncate(saved_answer.answer_payload[:answer], length: 150) %></span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>
    <p hidden class="text-sm text-muted-foreground" data-meeting-prep-target="pickerEmpty">No saved answers match this search.</p>
    <% if @available_saved_answers.empty? %>
      <p class="text-sm text-muted-foreground">There are no other saved answers to add.</p>
    <% end %>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-xs text-muted-foreground" role="status" data-meeting-prep-target="selectionCount" data-testid="meeting-prep-selection-count">0 selected</p>
      <%= form.button "Add answers", id: "meeting-prep-add-answers", aria: { disabled: true }, class: "h-11 rounded-full bg-primary px-5 text-sm font-medium text-white hover:bg-primary/90 aria-disabled:opacity-50", data: { meeting_prep_target: "addButton", testid: "meeting-prep-add-answer" } %>
    </div>
  <% end %>
  <%= link_to "Browse saved answers", dependent_saved_answers_path(@dependent), class: "inline-flex text-sm font-medium text-primary underline decoration-primary/30 underline-offset-2" %>
</section>

<section class="space-y-4" aria-label="Answers for this meeting" data-controller="meeting-prep-filter">
  <div class="rounded-2xl border border-border/50 bg-white p-4">
    <%= label_tag "meeting-prep-filter", "Find in this meeting", class: "block text-sm font-medium text-foreground" %>
    <div class="mt-2 flex items-center gap-3">
      <%= search_field_tag :meeting_filter, nil, id: "meeting-prep-filter", placeholder: "Search answers, notes, or sources", autocomplete: "off", class: "block h-11 min-w-0 flex-1 rounded-xl border border-border bg-white px-3 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/10", data: { meeting_prep_filter_target: "query", action: "input->meeting-prep-filter#filter", testid: "meeting-prep-filter" } %>
      <button id="meeting-prep-filter-clear" type="button" hidden class="h-11 rounded-full border border-border px-4 text-sm font-medium text-primary hover:bg-muted" data-meeting-prep-filter-target="clear" data-action="meeting-prep-filter#clear" data-testid="meeting-prep-filter-clear">Clear</button>
    </div>
    <p class="mt-2 text-xs text-muted-foreground" role="status" data-meeting-prep-filter-target="count" data-testid="meeting-prep-filter-count"><%= pluralize(@meeting_prep_answers.size, "saved answer") %></p>
  </div>
  <p hidden class="rounded-2xl border border-dashed border-border bg-white p-6 text-center text-sm text-muted-foreground" data-meeting-prep-filter-target="empty" data-testid="meeting-prep-filter-empty">No answers match. Try another search or clear the filter.</p>

  <% @meeting_prep_answers.each_with_index do |meeting_prep_answer, index| %>
    <%= render "meeting_preps/answer", meeting_prep_answer: meeting_prep_answer, index: index %>
  <% end %>

  <% if @meeting_prep_answers.empty? %>
    <section class="rounded-2xl border border-dashed border-border bg-white p-8 text-center">
      <h2 class="text-base font-semibold text-foreground">No answers in this meeting yet</h2>
      <p class="mt-2 text-sm text-muted-foreground">Select saved answers above to start preparing.</p>
    </section>
  <% end %>
</section>
