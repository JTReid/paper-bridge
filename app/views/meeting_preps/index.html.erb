<% content_for :title, "Meeting prep | PaperBridge" %>

<%= app_shell(active: :ai_assistant, dependent: @dependent) do %>
  <div class="space-y-6">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">Meeting prep</h1>
        <p class="mt-1 text-sm text-muted-foreground">Bring your saved answers together for <%= @dependent.name %>’s meetings. Only you can see them.</p>
      </div>
      <%= link_to "New meeting prep", new_dependent_meeting_prep_path(@dependent), class: "inline-flex h-11 shrink-0 items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-white hover:bg-primary/90", data: { testid: "meeting-prep-new-link" } %>
    </header>

    <%= render "shared/research_nav", dependent: @dependent, active: :meeting_prep %>

    <% if @meeting_preps.any? %>
      <section class="grid gap-4 md:grid-cols-2" aria-label="Meeting preps">
        <% @meeting_preps.each do |meeting_prep| %>
          <article class="rounded-2xl border border-border/50 bg-white p-5" data-testid="meeting-prep-<%= meeting_prep.id %>">
            <h2 class="break-words text-base font-semibold text-primary">
              <%= link_to meeting_prep.name, dependent_meeting_prep_path(@dependent, meeting_prep), class: "underline decoration-primary/20 underline-offset-4 hover:decoration-primary" %>
            </h2>
            <p class="mt-3 text-sm text-muted-foreground"><%= pluralize(meeting_prep.meeting_prep_answers.size, "saved answer") %></p>
          </article>
        <% end %>
      </section>
    <% else %>
      <section class="rounded-2xl border border-dashed border-border bg-white p-8 text-center">
        <h2 class="text-base font-semibold text-foreground">Get ready for your next meeting</h2>
        <p class="mt-2 text-sm text-muted-foreground">Create a meeting prep, then add saved answers and arrange them in the order you want to discuss them.</p>
      </section>
    <% end %>
  </div>
<% end %>
