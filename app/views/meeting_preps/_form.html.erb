<%= form_with model: [@dependent, meeting_prep], class: "space-y-5 rounded-2xl border border-border/50 bg-white p-4 sm:p-6" do |form| %>
  <% if meeting_prep.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900" role="alert">
      <h2 class="font-semibold">We couldn’t save this meeting prep</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% meeting_prep.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Meeting name", class: "block text-sm font-medium text-foreground" %>
    <%= form.text_field :name, required: true, placeholder: "For example, Fall IEP meeting", class: "mt-2 block w-full rounded-xl border border-border bg-white px-3 py-2 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/10", data: { testid: "meeting-prep-name-field" } %>
  </div>

  <div class="flex flex-wrap items-center justify-end gap-3 border-t border-border/50 pt-5">
    <%= link_to "Cancel", meeting_prep.persisted? ? dependent_meeting_prep_path(@dependent, meeting_prep) : dependent_meeting_preps_path(@dependent), class: "rounded-full px-4 py-2 text-sm font-medium text-muted-foreground hover:bg-muted" %>
    <%= form.submit meeting_prep.persisted? ? "Save changes" : "Create meeting prep", class: "rounded-full bg-primary px-5 py-2 text-sm font-medium text-white hover:bg-primary/90", data: { testid: "meeting-prep-submit" } %>
  </div>
<% end %>
