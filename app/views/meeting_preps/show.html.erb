<% content_for :title, "#{@meeting_prep.name} | PaperBridge" %>

<%= app_shell(active: :ai_assistant, dependent: @dependent) do %>
  <div class="mx-auto max-w-4xl space-y-6">
    <%= render "shared/research_nav", dependent: @dependent, active: :meeting_prep %>

    <header class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <h1 class="break-words text-2xl font-bold tracking-tight text-foreground md:text-3xl"><%= @meeting_prep.name %></h1>
        <p class="mt-1 text-sm text-muted-foreground">Your meeting prep for <%= @dependent.name %>. Open an answer to review it and your notes.</p>
      </div>
      <%= link_to "Edit meeting name", edit_dependent_meeting_prep_path(@dependent, @meeting_prep), class: "shrink-0 text-sm font-medium text-primary underline decoration-primary/30 underline-offset-2", data: { testid: "meeting-prep-edit" } %>
    </header>

    <div data-controller="meeting-prep"
         data-action="submit->meeting-prep#submit turbo:submit-start->meeting-prep#submitStart turbo:submit-end->meeting-prep#submitEnd turbo:before-stream-render@document->meeting-prep#beforeStreamRender turbo:before-cache@document->meeting-prep#beforeCache">
      <p id="<%= dom_id(@meeting_prep, :status) %>" role="status" class="mb-3 min-h-5 text-sm text-muted-foreground" data-meeting-prep-target="status" data-testid="meeting-prep-status"></p>
      <div id="<%= dom_id(@meeting_prep, :workspace) %>" class="space-y-6" data-meeting-prep-target="workspace">
        <%= render "workspace" %>
      </div>
    </div>

    <div class="flex justify-end border-t border-border/50 pt-5">
      <%= button_to "Delete meeting prep", dependent_meeting_prep_path(@dependent, @meeting_prep), method: :delete, class: "rounded-full px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50", form: { data: { turbo_confirm: "Delete this meeting prep? Your saved answers will stay in Saved answers." } }, data: { testid: "meeting-prep-delete" } %>
    </div>
  </div>
<% end %>
