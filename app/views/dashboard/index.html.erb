<% content_for :title, "Dashboard | PaperBridge" %>

<%= app_shell(active: :dashboard, product_tour_auto_start: @dependents.empty?) do %>
  <div class="space-y-10 pb-10">
    <header class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-1 text-xs font-medium uppercase tracking-widest text-accent">Your Family Hub</p>
        <h1 class="text-3xl font-bold tracking-tight text-primary">Good to see you.</h1>
        <p class="mt-1.5 text-sm text-muted-foreground">Everything in one place, always under control.</p>
      </div>
      <%= link_to new_dependent_path,
          class: "inline-flex h-10 items-center justify-center rounded-full bg-accent px-5 text-sm font-medium text-accent-foreground shadow-sm transition-all duration-200 hover:bg-accent/80",
          data: {
            action: "product-tour#advance",
            product_tour_from_phase_param: "create_profile",
            product_tour_next_phase_param: "profile_form",
            testid: "dashboard-add-profile",
            tour: "create-profile"
          } do %>
        <%= pb_icon("plus", class_name: "mr-1.5 h-4 w-4") %>
        Add Profile
      <% end %>
    </header>

    <section>
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-lg font-bold text-primary">Profiles</h2>
        <%= link_to dependents_path, class: "flex items-center gap-1 text-xs font-medium text-primary transition-opacity hover:opacity-70" do %>
          Manage
          <%= pb_icon("arrow-right", class_name: "h-3 w-3") %>
        <% end %>
      </div>

      <% if @dependents.any? %>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          <% @dependents.each_with_index do |dependent, index| %>
            <% colors = ["bg-blue-50 text-blue-700 border-blue-100", "bg-violet-50 text-violet-700 border-violet-100", "bg-amber-50 text-amber-700 border-amber-100", "bg-teal-50 text-teal-700 border-teal-100", "bg-rose-50 text-rose-700 border-rose-100"] %>
            <%= link_to dependent_path(dependent),
                class: "group rounded-2xl border border-border/60 bg-white p-6 transition-all duration-200 hover:border-accent/50 hover:shadow-md",
                data: {
                  action: "product-tour#advance",
                  product_tour_from_phase_param: "open_profile",
                  product_tour_next_phase_param: "open_documents",
                  testid: "dependent-card-#{dependent.id}",
                  tour: "open-profile"
                } do %>
              <div class="flex items-center gap-4">
                <%= dependent_avatar(
                  dependent,
                  class_name: "h-12 w-12 rounded-2xl border",
                  fallback_class_name: "text-sm font-bold #{colors[index % colors.length]}",
                  testid: "dependent-avatar-dashboard-#{dependent.id}"
                ) %>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-bold text-foreground transition-colors group-hover:text-primary"><%= dependent.name %></p>
                  <p class="mt-0.5 text-xs text-muted-foreground"><%= [dependent.grade, dependent.school].compact_blank.join(" · ").presence || "Profile ready" %></p>
                </div>
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-blue-50 hover:text-primary">
                  <%= pb_icon("pencil", class_name: "h-3.5 w-3.5") %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border border-border/60 bg-white p-8 shadow-sm">
          <div class="mx-auto max-w-md text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary">
              <%= pb_icon("users", class_name: "h-5 w-5") %>
            </div>
            <p class="text-sm font-semibold text-foreground">No profiles yet</p>
            <p class="mt-1 text-sm text-muted-foreground">Create a profile for the person whose records you want to organize.</p>
            <%= link_to "Add Profile", new_dependent_path, class: "mt-5 inline-flex rounded-full bg-primary px-5 py-2 text-xs font-medium text-white hover:bg-primary/90" %>
          </div>
        </div>
      <% end %>
    </section>

    <section class="rounded-2xl border border-border/50 bg-white p-6 shadow-sm">
      <div class="mb-5 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10">
            <%= pb_icon("calendar-days", class_name: "h-4 w-4 text-primary") %>
          </div>
          <div>
            <h2 class="text-base font-semibold text-foreground">Family Calendar</h2>
          </div>
        </div>
        <%= link_to calendar_path, class: "flex items-center gap-1 text-xs font-medium text-primary transition-opacity hover:opacity-70", data: { testid: "dashboard-calendar-link" } do %>
          View calendar
          <%= pb_icon("arrow-right", class_name: "h-3 w-3") %>
        <% end %>
      </div>

      <% if @upcoming_appointments.any? %>
        <div class="divide-y divide-border/40" data-testid="dashboard-upcoming-appointments">
          <% @upcoming_appointments.each do |appointment| %>
            <%= link_to calendar_path(month: appointment.scheduled_at.in_time_zone.strftime("%Y-%m")), class: "group flex items-center gap-4 py-3 first:pt-0 last:pb-0", data: { testid: "dashboard-appointment-#{appointment.id}" } do %>
              <time datetime="<%= appointment.scheduled_at.iso8601 %>" class="flex w-14 shrink-0 flex-col items-center rounded-xl bg-primary/5 px-2 py-2 text-primary">
                <span class="text-[10px] font-medium uppercase tracking-wide"><%= l appointment.scheduled_at, format: "%b" %></span>
                <span class="text-lg font-bold leading-tight"><%= appointment.scheduled_at.day %></span>
              </time>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-foreground group-hover:text-primary"><%= appointment.description %></p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                  <%= l appointment.scheduled_at, format: "%l:%M %p" %>
                  <span aria-hidden="true">&middot;</span>
                  <%= appointment.dependent.name %>
                </p>
              </div>
              <%= pb_icon("arrow-right", class_name: "h-4 w-4 shrink-0 text-muted-foreground transition-colors group-hover:text-primary") %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="py-8 text-center" data-testid="dashboard-calendar-empty-state">
          <%= pb_icon("calendar-days", class_name: "mx-auto mb-2 h-8 w-8 text-muted-foreground/40") %>
          <p class="text-sm text-muted-foreground">No upcoming appointments</p>
          <p class="mt-1 text-xs text-muted-foreground">Appointments added to the calendar will appear here.</p>
        </div>
      <% end %>
    </section>

    <footer class="flex items-center justify-center gap-6 border-t border-border/40 py-4">
      <% ["You control what gets shared", "Your data stays private", "Only invited people can see this"].each do |message| %>
        <p class="hidden text-[11px] text-muted-foreground sm:block"><%= message %></p>
      <% end %>
    </footer>
  </div>
<% end %>
