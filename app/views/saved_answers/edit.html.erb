<% content_for :title, "Edit saved answer | PaperBridge" %>

<%= app_shell(active: :ai_assistant, dependent: @dependent) do %>
  <div class="mx-auto max-w-2xl space-y-6">
    <%= render "shared/research_nav", dependent: @dependent, active: :saved_answers %>
    <h1 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">Edit saved answer</h1>

    <%= form_with model: [@dependent, @saved_answer], class: "space-y-5 rounded-2xl border border-border/50 bg-white p-4 sm:p-6" do |form| %>
      <% if @saved_answer.errors.any? %>
        <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900" role="alert">
          <h2 class="font-semibold">We couldn’t save your changes</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <% @saved_answer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :title, "Title (optional)", class: "block text-sm font-medium text-foreground" %>
        <%= form.text_field :title, placeholder: @saved_answer.question, class: "mt-2 block w-full rounded-xl border border-border bg-white px-3 py-2 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/10", data: { testid: "saved-answer-title-field" } %>
      </div>
      <div>
        <%= form.label :notes, "Your notes", class: "block text-sm font-medium text-foreground" %>
        <%= form.text_area :notes, rows: 7, class: "mt-2 block w-full rounded-xl border border-border bg-white px-3 py-2 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/10", data: { testid: "saved-answer-notes-field" } %>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-3 border-t border-border/50 pt-5">
        <%= link_to "Cancel", dependent_saved_answer_path(@dependent, @saved_answer), class: "rounded-full px-4 py-2 text-sm font-medium text-muted-foreground hover:bg-muted" %>
        <%= form.submit "Save changes", class: "rounded-full bg-primary px-5 py-2 text-sm font-medium text-white hover:bg-primary/90", data: { testid: "saved-answer-submit" } %>
      </div>
    <% end %>
  </div>
<% end %>
