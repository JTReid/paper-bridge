<% content_for :title, "#{@saved_answer.display_title} | PaperBridge" %>

<%= app_shell(active: :ai_assistant, dependent: @dependent) do %>
  <div class="mx-auto max-w-4xl space-y-6">
    <%= render "shared/research_nav", dependent: @dependent, active: :saved_answers %>

    <header>
      <h1 class="break-words text-2xl font-bold tracking-tight text-foreground md:text-3xl"><%= @saved_answer.display_title %></h1>
      <p class="mt-2 text-xs text-muted-foreground">
        Saved <time datetime="<%= @saved_answer.created_at.iso8601 %>"><%= l(@saved_answer.created_at.to_date, format: :long) %></time>
        <% if @saved_answer.generated_at.present? %>
          · Answer generated <time datetime="<%= @saved_answer.generated_at.iso8601 %>"><%= l(@saved_answer.generated_at.to_date, format: :long) %></time>
        <% end %>
      </p>
    </header>

    <section class="rounded-2xl border border-border/50 bg-white p-4">
      <h2 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Your question</h2>
      <p class="mt-2 break-words text-sm font-medium text-foreground"><%= @saved_answer.question %></p>
    </section>

    <%= render "shared/research_answer", answer: @saved_answer.answer_payload, documents_by_id: @saved_answer.source_documents_by_id, source_prefix: dom_id(@saved_answer) %>

    <section class="rounded-2xl border border-border/50 bg-white p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-base font-semibold text-foreground">Your notes</h2>
        <%= link_to "Edit title and notes", edit_dependent_saved_answer_path(@dependent, @saved_answer), class: "text-sm font-medium text-primary underline decoration-primary/30 underline-offset-2", data: { testid: "saved-answer-edit" } %>
      </div>
      <% if @saved_answer.notes.present? %>
        <p class="mt-3 whitespace-pre-wrap break-words text-sm leading-relaxed text-foreground" data-testid="saved-answer-notes"><%= @saved_answer.notes %></p>
      <% else %>
        <p class="mt-3 text-sm text-muted-foreground">No notes yet.</p>
      <% end %>
    </section>

    <section class="space-y-3 rounded-2xl border border-border/50 bg-white p-4 sm:p-6">
      <h2 class="text-base font-semibold text-foreground">Add to meeting prep</h2>
      <% if @meeting_preps.any? %>
        <%= form_with url: add_to_meeting_dependent_saved_answer_path(@dependent, @saved_answer), method: :post, class: "flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
          <div class="min-w-0 flex-1">
            <%= form.label :meeting_prep_id, "Meeting prep", class: "block text-sm font-medium text-foreground" %>
            <%= form.collection_select :meeting_prep_id, @meeting_preps, :id, :name, { prompt: "Choose a meeting" }, required: true, class: "mt-2 block h-11 w-full rounded-xl border border-border bg-white px-3 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/10", data: { testid: "saved-answer-meeting-select" } %>
          </div>
          <%= form.submit "Add to meeting", class: "h-11 rounded-full bg-primary px-5 text-sm font-medium text-white hover:bg-primary/90", data: { testid: "saved-answer-add-to-meeting" } %>
        <% end %>
      <% else %>
        <p class="text-sm text-muted-foreground">Create a meeting prep to bring your saved answers together.</p>
      <% end %>
      <%= link_to "New meeting prep", new_dependent_meeting_prep_path(@dependent), class: "inline-flex text-sm font-medium text-primary underline decoration-primary/30 underline-offset-2" %>
    </section>

    <div class="flex justify-end border-t border-border/50 pt-5">
      <%= button_to "Delete saved answer", dependent_saved_answer_path(@dependent, @saved_answer), method: :delete, class: "rounded-full px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50", form: { data: { turbo_confirm: "Delete this saved answer? It will also be removed from every meeting prep." } }, data: { testid: "saved-answer-delete" } %>
    </div>
  </div>
<% end %>
