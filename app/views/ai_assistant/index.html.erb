<% content_for :title, "Ask PaperBridge" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%
  guided_prompts = [
    "What are the most important updates across these documents?",
    "What supports or services are mentioned in the records?",
    "What progress has been documented recently?",
    "What should I ask about at the next meeting?",
    "What information appears to be missing?",
    "Summarize the latest educational records."
  ]
%>

<%= turbo_stream_from current_user, @dependent, :ai_assistant %>

<%= app_shell(active: :ai_assistant, dependent: @dependent) do %>
  <div
    class="space-y-6"
    data-controller="ai-assistant-query"
    data-ai-assistant-query-reassure-after-value="10000"
    data-ai-assistant-query-long-wait-after-value="30000"
    data-action="submit->ai-assistant-query#submit turbo:submit-end->ai-assistant-query#submitEnd turbo:before-cache@document->ai-assistant-query#beforeCache"
  >
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-ai-assistant-query-target="announcer"></p>

    <header>
      <p class="mb-1 text-xs font-medium uppercase tracking-widest text-accent">Questions &amp; Answers</p>
      <h1 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">Ask PaperBridge</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Ask questions about <%= @dependent.name %>’s documents and care records.
      </p>
      <p class="mt-2 text-xs text-muted-foreground">
        PaperBridge uses AI to answer from these records. Review the sources and confirm important details.
      </p>
    </header>

    <section class="space-y-2">
      <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Suggested questions</p>
      <div class="flex flex-wrap gap-2">
        <% guided_prompts.each do |question| %>
          <%= button_to question,
            dependent_ai_assistant_path(@dependent),
            method: :post,
            params: { q: question },
            class: "rounded-full border border-primary/20 bg-primary/5 px-3 py-1.5 text-left text-xs text-primary transition-colors hover:bg-primary/10 disabled:cursor-not-allowed disabled:opacity-50",
            data: { ai_assistant_query_target: "submitter" },
            form: { class: "contents" } %>
        <% end %>
      </div>
    </section>

    <section class="space-y-4 rounded-2xl border border-border/50 bg-white p-6">
      <%= form_with url: dependent_ai_assistant_path(@dependent), method: :post, class: "space-y-4", data: { testid: "ai-assistant-form" } do |form| %>
        <%= form.text_area :q, placeholder: "Ask a question about documents, care progress, or next steps...", class: "min-h-[110px] w-full resize-none rounded-xl border border-border bg-white px-3 py-3 text-sm text-foreground outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/10 read-only:bg-muted/30", data: { testid: "ai-assistant-query", ai_assistant_query_target: "input" } %>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs text-muted-foreground">Most answers begin appearing within about 30 seconds. Once your question is queued, you can leave this page while PaperBridge keeps working.</p>
          <%= button_tag type: :submit, class: "inline-flex h-9 shrink-0 items-center justify-center rounded-full bg-primary px-4 text-xs font-medium text-white transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50", data: { testid: "ai-assistant-submit", turbo_submits_with: "Asking…", ai_assistant_query_target: "submitter" } do %>
            <%= pb_icon("send", class_name: "mr-2 h-3.5 w-3.5") %>
            Ask
          <% end %>
        </div>
      <% end %>
    </section>

    <div id="ai_assistant_result_region" aria-busy="<%= @ai_assistant_query&.active? || false %>" data-ai-assistant-query-target="region">
      <div hidden class="rounded-2xl border border-primary/15 bg-primary/5 p-6" data-ai-assistant-query-target="optimistic" data-testid="ai-assistant-immediate-progress">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 h-5 w-5 animate-spin rounded-full border-2 border-primary/20 border-t-primary" aria-hidden="true"></span>
          <div>
            <p class="text-sm font-semibold text-primary">Starting your question…</p>
            <p class="mt-1 text-sm text-muted-foreground">PaperBridge is getting everything ready.</p>
          </div>
        </div>
      </div>

      <div id="ai_assistant_result" data-ai-assistant-query-target="result">
        <% if @ai_assistant_query.present? %>
          <%= render "ai_assistant/query_result", ai_assistant_query: @ai_assistant_query %>
        <% else %>
          <section class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <article class="rounded-2xl border border-border/50 bg-muted/40 p-5">
            <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10">
              <%= pb_icon("search", class_name: "h-4 w-4 text-primary") %>
            </div>
            <h2 class="text-sm font-semibold text-foreground">Answers with sources</h2>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">Each answer can show the document and page it came from.</p>
          </article>
          <article class="rounded-2xl border border-border/50 bg-muted/40 p-5">
            <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10">
              <%= pb_icon("file-text", class_name: "h-4 w-4 text-primary") %>
            </div>
            <h2 class="text-sm font-semibold text-foreground"><%= pluralize(@documents.count, "document") %> available</h2>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">PaperBridge only uses documents you’re allowed to view.</p>
          </article>
          <article class="rounded-2xl border border-border/50 bg-muted/40 p-5">
            <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10">
              <%= pb_icon("shield", class_name: "h-4 w-4 text-primary") %>
            </div>
            <h2 class="text-sm font-semibold text-foreground">Based on your records</h2>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">If the answer isn’t in the documents, PaperBridge will say so.</p>
          </article>
          </section>
        <% end %>
      </div>

      <p hidden class="mt-3 text-xs text-muted-foreground" data-ai-assistant-query-target="elapsed" data-testid="ai-assistant-elapsed"></p>
    </div>
  </div>
<% end %>
