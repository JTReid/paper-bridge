<%
  phase = if ai_assistant_query.failed?
    "failed"
  elsif ai_assistant_query.completed?
    "completed"
  elsif ai_assistant_query.draft_answer.present?
    "drafting"
  elsif ai_assistant_query.processing?
    "searching"
  else
    "queued"
  end

  announcements = {
    "queued" => "Your question is queued.",
    "searching" => "PaperBridge is looking through the documents.",
    "drafting" => "PaperBridge is drafting your answer.",
    "completed" => "Your PaperBridge answer is ready.",
    "failed" => "PaperBridge couldn’t answer that question right now."
  }
%>

<article
  id="<%= dom_id(ai_assistant_query) %>"
  class="space-y-6"
  data-ai-assistant-query-target="query"
  data-query-id="<%= ai_assistant_query.id %>"
  data-query-version="<%= ai_assistant_query.updated_at.utc.iso8601(6) %>"
  data-phase="<%= phase %>"
  data-active="<%= ai_assistant_query.active? %>"
  data-started-at="<%= ai_assistant_query.created_at.iso8601 %>"
  data-announcement="<%= announcements.fetch(phase) %>"
  <% if ai_assistant_query.active? %>
    data-status-url="<%= status_dependent_ai_assistant_query_path(ai_assistant_query.dependent, ai_assistant_query) %>"
  <% end %>
  <% if ai_assistant_query.queued? && ai_assistant_query.enqueued_at.nil? %>
    data-start-url="<%= start_dependent_ai_assistant_query_path(ai_assistant_query.dependent, ai_assistant_query) %>"
  <% end %>
  data-testid="ai-assistant-query-result"
>
  <section class="rounded-2xl border border-border/50 bg-white p-4">
    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Your question</p>
    <p class="mt-2 text-sm font-medium text-foreground"><%= ai_assistant_query.question %></p>
  </section>

  <% if ai_assistant_query.active? %>
    <% if ai_assistant_query.draft_answer.present? %>
      <section class="rounded-2xl border border-primary/10 bg-white p-6" data-testid="ai-assistant-draft">
        <div class="flex items-center gap-2">
          <%= pb_icon("brain", class_name: "h-4 w-4 text-primary") %>
          <h2 class="text-sm font-semibold text-primary">Draft answer</h2>
        </div>
        <p class="mt-4 whitespace-pre-wrap break-words text-sm leading-relaxed text-foreground"><%= ai_assistant_query.draft_answer %></p>
        <p class="mt-4 text-xs text-muted-foreground">
          PaperBridge is checking the sources. The final answer may change.
        </p>
      </section>
    <% else %>
      <section class="rounded-2xl border border-primary/15 bg-primary/5 p-6">
        <div class="flex items-start gap-3">
          <%= pb_icon("brain", class_name: "mt-0.5 h-5 w-5 text-primary") %>
          <div>
            <p class="text-sm font-semibold text-primary" data-ai-assistant-start-status>
              <%= ai_assistant_query.processing? ? "Looking through #{ai_assistant_query.dependent.name}’s documents…" : "Your question is queued" %>
            </p>
            <p class="mt-1 text-sm text-muted-foreground">You can stay on this page while the answer is prepared.</p>
          </div>
        </div>
      </section>
    <% end %>
  <% elsif ai_assistant_query.failed? %>
    <section class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-900">
      <p class="font-semibold">We couldn’t answer that right now</p>
      <p class="mt-1"><%= ai_assistant_query.error_message %></p>
    </section>
  <% elsif ai_assistant_query.completed? %>
    <% answer = ai_assistant_query.answer_payload %>
    <% documents_by_id = ai_assistant_query.source_documents_by_id %>

    <% if answer[:answer].present? %>
      <div class="flex flex-wrap justify-end gap-3">
        <%= link_to "Email answer", new_dependent_ai_assistant_email_path(ai_assistant_query.dependent, ai_assistant_query),
          id: "ai-assistant-email-trigger-#{ai_assistant_query.id}",
          class: "rounded-full border border-primary/20 px-4 py-2 text-sm font-medium text-primary hover:bg-primary/5",
          data: { turbo_frame: "ai_assistant_email", testid: "ai-assistant-email-answer" } %>
        <%= button_to "Save answer", dependent_saved_answers_path(ai_assistant_query.dependent),
          params: { ai_assistant_query_id: ai_assistant_query.id },
          class: "rounded-full bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90",
          data: { testid: "ai-assistant-save-answer" } %>
      </div>
      <%= render "shared/research_answer", answer: answer, documents_by_id: documents_by_id, source_prefix: "ai" %>
    <% elsif ai_assistant_query.result_count.to_i.positive? %>
      <section class="rounded-2xl border border-border/50 bg-white p-6 text-sm text-muted-foreground">
        PaperBridge found related information but couldn’t create an answer. Try asking in a different way.
      </section>
    <% else %>
      <section class="rounded-2xl border border-dashed border-border bg-white px-4 py-10 text-center">
        <p class="text-sm font-medium text-foreground">We couldn’t find an answer in these documents.</p>
        <p class="mt-1 text-sm text-muted-foreground">Try another question, or check that the documents you need are ready.</p>
      </section>
    <% end %>
  <% end %>
</article>
