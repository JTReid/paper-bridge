<article id="<%= dom_id(ai_assistant_query) %>" class="space-y-6">
  <section class="rounded-2xl border border-border/50 bg-white p-4">
    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Your question</p>
    <p class="mt-2 text-sm font-medium text-foreground"><%= ai_assistant_query.question %></p>
  </section>

  <% if ai_assistant_query.active? %>
    <section class="rounded-2xl border border-primary/15 bg-primary/5 p-6">
      <div class="flex items-start gap-3">
        <%= pb_icon("brain", class_name: "mt-0.5 h-5 w-5 text-primary") %>
        <div>
          <p class="text-sm font-semibold text-primary">
            <%= ai_assistant_query.processing? ? "PaperBridge is reading the records" : "Your question is in line" %>
          </p>
          <p class="mt-1 text-sm text-muted-foreground">You can stay on this page while the answer is prepared.</p>
        </div>
      </div>
    </section>
  <% elsif ai_assistant_query.failed? %>
    <section class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-900">
      <p class="font-semibold">We couldn’t answer that right now</p>
      <p class="mt-1"><%= ai_assistant_query.error_message %></p>
    </section>
  <% elsif ai_assistant_query.completed? %>
    <% answer = ai_assistant_query.answer_payload %>
    <% citations = Array(answer[:citations]) %>
    <% documents_by_id = ai_assistant_query.source_documents_by_id %>

    <% if answer[:answer].present? %>
      <div class="space-y-6"<% if citations.any? %> data-controller="citations-toggle"<% end %>>
        <section class="rounded-2xl border border-primary/10 bg-white p-6">
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-2">
              <%= pb_icon("brain", class_name: "h-4 w-4 text-primary") %>
              <span class="text-sm font-semibold text-primary">PaperBridge Answer</span>
            </div>
            <% if citations.any? %>
              <button type="button" class="inline-flex h-8 items-center justify-center rounded-full border border-primary/20 bg-primary/5 px-3 text-xs font-medium text-primary transition-colors hover:bg-primary/10" aria-expanded="false" aria-controls="ai-answer-citations" data-citations-toggle-target="button" data-action="citations-toggle#toggle">
                <%= pb_icon("file-text", class_name: "mr-1.5 h-3.5 w-3.5") %>
                <span data-citations-toggle-target="showLabel">Show sources</span>
                <span data-citations-toggle-target="hideLabel" hidden>Hide sources</span>
              </button>
            <% end %>
          </div>
          <div class="text-sm leading-relaxed text-foreground">
            <%= ai_answer_with_source_links(answer[:answer], citations: citations, documents_by_id: documents_by_id) %>
          </div>
          <p class="mt-4 text-[10px] italic text-muted-foreground">This AI-generated answer is for informational purposes only and is not professional advice.</p>
        </section>

        <% if citations.any? %>
          <section id="ai-answer-citations" class="space-y-3" hidden data-citations-toggle-target="content">
            <div>
              <h2 class="text-base font-bold text-primary">Sources</h2>
              <p class="mt-1 text-sm text-muted-foreground">Where this answer came from.</p>
            </div>
            <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
              <% citations.each do |citation| %>
                <article id="ai-source-<%= citation[:source_number] %>" class="rounded-2xl border border-border/50 bg-white p-4">
                  <p class="text-sm font-semibold">
                    <%= ai_source_link(
                      citation,
                      documents_by_id: documents_by_id,
                      class_name: "text-primary underline decoration-primary/30 underline-offset-2 hover:decoration-primary",
                      testid: "ai-source-card-#{citation[:source_number]}"
                    ) %>
                  </p>
                  <% if citation[:quote].present? %>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground"><%= citation[:quote] %></p>
                  <% end %>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>

      <% if Array(answer[:limitations]).any? %>
        <section class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          <h2 class="font-semibold">Things to keep in mind</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <% Array(answer[:limitations]).each do |limitation| %>
              <li><%= limitation %></li>
            <% end %>
          </ul>
        </section>
      <% end %>
    <% elsif ai_assistant_query.result_count.to_i.positive? %>
      <section class="rounded-2xl border border-border/50 bg-white p-6 text-sm text-muted-foreground">
        PaperBridge found related information but couldn’t create an answer. Try asking in a different way.
      </section>
    <% else %>
      <section class="rounded-2xl border border-dashed border-border bg-white px-4 py-10 text-center">
        <p class="text-sm font-medium text-foreground">We couldn’t find an answer in these documents.</p>
        <p class="mt-1 text-sm text-muted-foreground">Try another question, or check that the documents you need are ready.</p>
      </section>
    <% end %>
  <% end %>
</article>
