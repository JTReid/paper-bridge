<% if (limit = current_account.profile_limit).present? %>
  <% profile_count = current_account.dependents.count %>
  <section class="rounded-xl border border-border/50 bg-white p-4 text-sm" aria-label="Managed profile allowance" data-testid="profile-allowance">
    <p class="font-medium text-foreground"><%= profile_count %> of <%= limit %> managed profiles in use.</p>
    <p class="mt-1 text-muted-foreground">Care team members and account logins do not count toward this allowance.</p>
    <% if profile_count >= limit %>
      <p class="mt-2 text-muted-foreground" data-testid="profile-limit-reached">
        <%= profile_count > limit ? "You're over your current profile allowance." : "Your profile allowance is full." %>
        Increase the allowance before adding another profile. Your existing profiles and documents stay available.
      </p>
      <% if local_assigns.fetch(:show_billing_link, true) %>
        <%= link_to "Manage profile allowance in Billing", billing_path, class: "mt-2 inline-flex font-medium text-primary underline", data: { testid: "profile-allowance-billing-link" } %>
      <% end %>
    <% end %>
  </section>
<% end %>
