<%
  dependent_context = dependent.present?
  account_name = current_account&.name || "PaperBridge"
  actor_label = current_user.name.presence || current_user.email
  product_access = current_user&.super_admin? || current_account&.subscription_active?
  shell_home_path = if dependent_context || (product_access && current_account.present?)
    dashboard_path
  elsif current_user&.super_admin?
    admin_accounts_path
  else
    billing_path
  end

  if dependent_context
    dependent_meta = [dependent.grade, dependent.school].compact_blank.join(" - ")
    nav_items = [
      { key: :overview, label: "Overview", path: dependent_path(dependent), icon: "user-circle" },
      { key: :documents, label: "Documents", path: dependent_documents_path(dependent), icon: "file-text" },
      {
        key: :calendar,
        label: "Calendar",
        path: calendar_path(calendar_context_id: dependent.id, panel: 1),
        icon: "calendar-days",
        calendar_panel: true
      },
      { key: :ai_assistant, label: "Ask PaperBridge", path: dependent_ai_assistant_path(dependent), icon: "brain" },
      { key: :care_team, label: "Care Team", path: dependent_care_team_memberships_path(dependent), icon: "users" }
    ]
  else
    nav_items = if current_account.present? && product_access
      [
        { key: :dashboard, label: "Dashboard", path: dashboard_path, icon: "sparkles" },
        { key: :calendar, label: "Calendar", path: calendar_path, icon: "calendar-days" },
        { key: :billing, label: "Billing", path: billing_path, icon: "shield" }
      ]
    elsif current_account.present?
      [
        { key: :billing, label: "Billing", path: billing_path, icon: "shield" }
      ]
    else
      []
    end

    if current_user&.super_admin?
      nav_items << { key: :admin_accounts, label: "Admin", path: admin_accounts_path, icon: "lock" }
    end
  end

  shell_controllers = []
  shell_actions = []

  if product_tour_enabled
    shell_controllers << "product-tour"
    shell_actions << "turbo:before-cache@document->product-tour#beforeCache"
  end

  if dependent_context
    shell_controllers << "family-calendar"
    shell_actions.concat([
      "turbo:click->family-calendar#expectFrameNavigation",
      "turbo:submit-start->family-calendar#expectFrameResult",
      "turbo:frame-load->family-calendar#focusFrameUpdate",
      "turbo:before-cache@document->family-calendar#beforeCache"
    ])
  end
%>

<main
  class="min-h-screen bg-background text-foreground lg:flex"
  data-testid="app-shell"
  data-controller="<%= shell_controllers.join(" ") %>"
  data-action="<%= shell_actions.join(" ") %>"
  <% if product_tour_enabled %>
    data-product-tour-account-id-value="<%= current_account.id %>"
    data-product-tour-auto-start-value="<%= product_tour_auto_start %>"
    data-product-tour-dashboard-url-value="<%= dashboard_path %>"
  <% end %>
>
  <aside class="hidden min-h-screen w-[248px] shrink-0 border-r border-border/50 bg-white lg:flex lg:flex-col" data-testid="desktop-sidebar">
    <% if dependent_context %>
      <div class="border-b border-border/40 px-4 py-6">
        <%= link_to dashboard_path, class: "inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground", data: { testid: "all-profiles-link" } do %>
          <%= pb_icon("arrow-left", class_name: "h-4 w-4") %>
          All Profiles
        <% end %>

        <div class="mt-5 flex items-center gap-3">
          <%= dependent_avatar(
            dependent,
            class_name: "h-11 w-11 rounded-2xl",
            fallback_class_name: "bg-primary/10 text-sm font-bold text-primary",
            testid: "dependent-avatar-sidebar"
          ) %>
          <div class="min-w-0">
            <p class="truncate text-sm font-bold text-foreground"><%= dependent.name %></p>
            <% if dependent_meta.present? %>
              <p class="mt-0.5 truncate text-xs text-muted-foreground"><%= dependent_meta %></p>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="border-b border-border/40 p-5">
        <%= link_to root_path, class: "block", aria: { label: "PaperBridge home" } do %>
          <%= paperbridge_logo(width: 156, height: 54, class_name: "h-[54px] w-[156px]") %>
        <% end %>
      </div>
    <% end %>

    <nav class="flex-1 space-y-1 px-3 py-4" aria-label="Primary navigation">
      <% nav_items.each do |item| %>
        <% active_item = active == item[:key] %>
        <%
          item_data = { testid: "nav-#{item[:key].to_s.dasherize}" }
          item_aria = {}
          if item[:calendar_panel]
            item_data.merge!(
              turbo_frame: CalendarWorkspace::FAMILY_CALENDAR_FRAME_ID,
              action: "family-calendar#open",
              family_calendar_target: "trigger"
            )
            item_aria.merge!(haspopup: "dialog", expanded: false, controls: "family-calendar-dialog")
          end
        %>
        <%= link_to item[:path], class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-all duration-150 #{active_item ? "bg-primary text-white shadow-sm" : "text-muted-foreground hover:bg-muted/60 hover:text-foreground"}", data: item_data, aria: item_aria do %>
          <%= pb_icon(item[:icon], class_name: "h-4 w-4 shrink-0") %>
          <span><%= item[:label] %></span>
        <% end %>
      <% end %>
    </nav>

    <div class="border-t border-border/40 p-4">
      <p class="text-[10px] uppercase tracking-wider text-muted-foreground">Family account</p>
      <p class="mt-1 truncate text-sm font-semibold text-foreground"><%= account_name %></p>
      <p class="mt-1 truncate text-xs text-muted-foreground"><%= actor_label %></p>
      <% if product_tour_enabled %>
        <button
          type="button"
          class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl border border-border bg-white px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground focus:outline-none focus:ring-2 focus:ring-primary/30"
          data-action="product-tour#replay"
          data-testid="product-tour-replay"
        >
          <%= pb_icon("play", class_name: "h-3.5 w-3.5") %>
          Replay setup tour
        </button>
      <% end %>
      <%= button_to destroy_user_session_path,
          method: :delete,
          class: "mt-3 flex w-full items-center justify-center rounded-xl border border-border bg-white px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground",
          data: { testid: "logout-button" } do %>
        Log Out
      <% end %>
    </div>
  </aside>

  <div class="min-w-0 flex-1">
    <header class="sticky top-0 z-40 border-b border-border/50 bg-white/85 backdrop-blur-xl lg:hidden">
      <div class="flex h-16 items-center justify-between px-5">
        <%= link_to(shell_home_path, class: "flex items-center", aria: { label: "PaperBridge home" }) do %>
          <%= paperbridge_logo(width: 140, height: 50, class_name: "h-[50px] w-[140px]") %>
        <% end %>
        <details class="group">
          <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full text-foreground transition-colors hover:bg-muted [&::-webkit-details-marker]:hidden">
            <%= pb_icon("menu", class_name: "h-5 w-5") %>
          </summary>
          <div class="absolute left-0 right-0 top-16 border-b border-border bg-white px-5 py-4 shadow-sm">
            <% if dependent_context %>
              <div class="mb-4 border-b border-border/50 pb-4">
                <%= link_to dashboard_path, class: "mb-4 inline-flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground" do %>
                  <%= pb_icon("arrow-left", class_name: "h-4 w-4") %>
                  All Profiles
                <% end %>
                <div class="flex items-center gap-3">
                  <%= dependent_avatar(
                    dependent,
                    class_name: "h-10 w-10 rounded-2xl",
                    fallback_class_name: "bg-primary/10 text-sm font-bold text-primary",
                    testid: "dependent-avatar-mobile-menu"
                  ) %>
                  <div class="min-w-0">
                    <p class="truncate text-sm font-bold text-foreground"><%= dependent.name %></p>
                    <% if dependent_meta.present? %>
                      <p class="mt-0.5 truncate text-xs text-muted-foreground"><%= dependent_meta %></p>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <div class="space-y-2">
              <% nav_items.each do |item| %>
                <% active_item = active == item[:key] %>
                <%
                  item_data = {}
                  item_aria = {}
                  if item[:calendar_panel]
                    item_data.merge!(
                      testid: "mobile-nav-calendar",
                      turbo_frame: CalendarWorkspace::FAMILY_CALENDAR_FRAME_ID,
                      action: "family-calendar#open",
                      family_calendar_target: "trigger"
                    )
                    item_aria.merge!(haspopup: "dialog", expanded: false, controls: "family-calendar-dialog")
                  end
                %>
                <%= link_to item[:path], class: "flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium #{active_item ? "bg-primary text-white" : "text-muted-foreground hover:bg-muted"}", data: item_data, aria: item_aria do %>
                  <%= pb_icon(item[:icon], class_name: "h-4 w-4") %>
                  <%= item[:label] %>
                <% end %>
              <% end %>
            </div>

            <div class="mt-4 border-t border-border/50 pt-4">
              <% if product_tour_enabled %>
                <button
                  type="button"
                  class="mb-2 flex w-full items-center justify-center gap-2 rounded-xl border border-border bg-white px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground focus:outline-none focus:ring-2 focus:ring-primary/30"
                  data-action="product-tour#replay"
                  data-testid="mobile-product-tour-replay"
                >
                  <%= pb_icon("play", class_name: "h-3.5 w-3.5") %>
                  Replay setup tour
                </button>
              <% end %>
              <%= button_to destroy_user_session_path,
                  method: :delete,
                  class: "flex w-full items-center justify-center rounded-xl border border-border bg-white px-3 py-2 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground",
                  data: { testid: "mobile-logout-button" } do %>
                Log Out
              <% end %>
            </div>
          </div>
        </details>
      </div>
    </header>

    <section class="mx-auto max-w-6xl px-5 py-8 sm:px-6 md:py-10 lg:px-8" data-testid="app-content">
      <%= content %>
    </section>
  </div>

  <% if dependent_context %>
    <dialog
      id="family-calendar-dialog"
      class="fixed inset-0 m-auto h-dvh max-h-none w-full max-w-none overflow-hidden border-0 bg-white p-0 text-foreground shadow-2xl backdrop:bg-slate-950/40 backdrop:backdrop-blur-sm sm:h-[calc(100dvh-3rem)] sm:max-h-[60rem] sm:w-[calc(100vw-3rem)] sm:max-w-7xl sm:rounded-2xl sm:border sm:border-border/60"
      data-family-calendar-target="dialog"
      data-action="click->family-calendar#closeOnBackdrop close->family-calendar#restorePage"
      data-testid="family-calendar-dialog"
      aria-labelledby="family-calendar-title"
    >
      <div class="flex h-full min-h-0 flex-col">
        <header class="flex shrink-0 items-start justify-between gap-4 border-b border-border/60 bg-white px-5 py-4 sm:px-6">
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-accent">Family Schedule</p>
            <h2 id="family-calendar-title" class="mt-1 text-xl font-bold text-primary sm:text-2xl">Family Calendar</h2>
            <p class="mt-1 text-sm text-muted-foreground">
              See everyone’s appointments. New appointments start with <%= dependent.name %>.
            </p>
          </div>
          <button
            type="button"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-border bg-white text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus:outline-none focus:ring-2 focus:ring-primary/30"
            data-action="family-calendar#close"
            data-family-calendar-target="closeButton"
            data-testid="family-calendar-close"
            aria-label="Close family calendar"
          >
            <%= pb_icon("x", class_name: "h-4 w-4") %>
          </button>
        </header>

        <%= turbo_frame_tag CalendarWorkspace::FAMILY_CALENDAR_FRAME_ID, class: "block min-h-0 flex-1 overflow-y-auto bg-background p-4 sm:p-6", data: { testid: "family-calendar-frame" } do %>
          <div class="flex min-h-64 items-center justify-center" role="status">
            <p class="text-sm text-muted-foreground">Loading the family calendar…</p>
          </div>
        <% end %>
      </div>
    </dialog>
  <% end %>
</main>
