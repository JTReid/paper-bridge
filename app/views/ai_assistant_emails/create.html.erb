<%= render layout: "dialog" do %>
  <p class="break-words rounded-xl bg-primary/5 p-4 text-sm" role="status" tabindex="-1" autofocus>Answer emailed to <%= @recipient_email %>.</p>
  <div class="mt-5 flex justify-end">
    <button type="button" class="rounded-full bg-primary px-5 py-2 text-sm font-medium text-white hover:bg-primary/90" data-action="ai-assistant-email#close">Done</button>
  </div>
<% end %>
