<% content_for :title, "Email answer | PaperBridge" %>

<%= turbo_frame_tag "ai_assistant_email" do %>
  <dialog class="m-auto max-h-[calc(100dvh_-_2rem)] w-[calc(100vw_-_2rem)] max-w-lg overflow-y-auto rounded-2xl border border-border bg-white p-6 text-foreground shadow-xl backdrop:bg-slate-950/35 backdrop:backdrop-blur-sm"
    aria-labelledby="ai-assistant-email-title"
    data-controller="ai-assistant-email"
    data-ai-assistant-email-trigger-id-value="ai-assistant-email-trigger-<%= @query.id %>"
    data-action="close->ai-assistant-email#restoreFocus turbo:before-cache@document->ai-assistant-email#close">
    <header class="mb-5 flex items-start justify-between gap-4">
      <div>
        <h2 id="ai-assistant-email-title" class="text-xl font-bold text-primary">Email answer</h2>
        <p class="mt-1 text-sm text-muted-foreground">For <%= @dependent.name %></p>
      </div>
      <button type="button" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border hover:bg-muted" aria-label="Close email dialog" data-action="ai-assistant-email#close" data-testid="ai-assistant-email-close">
        <%= pb_icon("x", class_name: "h-4 w-4") %>
      </button>
    </header>

    <%= yield %>
  </dialog>
<% end %>
