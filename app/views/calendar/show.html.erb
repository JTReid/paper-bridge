<% if turbo_frame_request_id == CalendarWorkspace::FAMILY_CALENDAR_FRAME_ID %>
  <%= turbo_frame_tag CalendarWorkspace::FAMILY_CALENDAR_FRAME_ID, data: { testid: "family-calendar-frame" } do %>
    <%= render "calendar/workspace", panel: true %>
  <% end %>
<% else %>
  <% content_for :title, "Calendar | PaperBridge" %>

  <%= app_shell(active: :calendar) do %>
    <div class="space-y-8">
      <header>
        <p class="mb-1 text-xs font-medium uppercase tracking-widest text-accent">Family Schedule</p>
        <h1 class="text-2xl font-bold tracking-tight text-primary md:text-3xl">Calendar</h1>
        <p class="mt-1.5 text-sm text-muted-foreground">Appointments for everyone in your family account.</p>
      </header>

      <%= render "calendar/workspace", panel: false %>
    </div>
  <% end %>
<% end %>
