<%
  compact = local_assigns.fetch(:compact, true)
  testid = local_assigns.fetch(:testid, "appointment-#{appointment.id}")
%>

<button
  type="button"
  class="<%= compact ? "block w-full rounded-lg bg-primary/10 px-2 py-1.5 text-left text-primary transition-colors hover:bg-primary/15 focus:outline-none focus:ring-2 focus:ring-primary/30" : "flex w-full items-start gap-3 rounded-xl border border-border/60 bg-white px-4 py-3 text-left text-foreground shadow-sm transition-colors hover:border-primary/20 hover:bg-primary/5 focus:outline-none focus:ring-2 focus:ring-primary/30" %>"
  data-action="appointment-dialog#open"
  data-appointment-dialog-appointment-id-param="<%= appointment.id %>"
  data-appointment-dialog-dependent-param="<%= appointment.dependent.name %>"
  data-appointment-dialog-scheduled-at-param="<%= appointment.scheduled_at.in_time_zone.strftime("%A, %B %-d, %Y at %-I:%M %p %Z") %>"
  data-appointment-dialog-description-param="<%= appointment.description %>"
  data-testid="<%= testid %>"
>
  <% if compact %>
    <span class="block text-[10px] font-semibold"><%= appointment.scheduled_at.in_time_zone.strftime("%-I:%M %p") %></span>
    <span class="block truncate text-[11px] font-medium"><%= appointment.dependent.name %></span>
    <span class="block truncate text-[10px] text-primary"><%= appointment.description %></span>
  <% else %>
    <time datetime="<%= appointment.scheduled_at.iso8601 %>" class="shrink-0 rounded-lg bg-primary/10 px-2 py-1 text-xs font-semibold text-primary">
      <%= appointment.scheduled_at.in_time_zone.strftime("%-I:%M %p") %>
    </time>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-semibold"><%= appointment.dependent.name %></span>
      <span class="mt-0.5 block text-sm text-muted-foreground"><%= appointment.description %></span>
    </span>
  <% end %>
</button>
